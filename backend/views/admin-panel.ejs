<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Panel — Photo Gallery | Air Prime Asia' %></title>
  <meta name="description" content="Admin Photo Gallery management panel for Air Prime Asia.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:         #0A1128;
      --navy-mid:     #101E42;
      --navy-light:   #172B5E;
      --navy-border:  #1E2D56;
      --gold:         #F4B324;
      --gold-dark:    #D49B1A;
      --white:        #FFFFFF;
      --bg-page:      #0D1530;
      --bg-card:      rgba(16, 30, 66, 0.85);
      --text-primary: #E8ECF4;
      --text-muted:   #8A95AD;
      --text-dimmed:  #5A647B;
      --border:       rgba(255, 255, 255, 0.08);
      --success:      #10B981;
      --error:        #EF4444;
      --sidebar-w:    240px;
      --header-h:     64px;
    }

    html, body {
      height: 100%;
      font-family: 'Inter', sans-serif;
      background: var(--bg-page);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* ═══════════════════════════════════════════════
       SIDEBAR
    ═══════════════════════════════════════════════ */
    .sidebar {
      position: fixed; top: 0; left: 0; bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, var(--navy-mid) 0%, var(--navy) 100%);
      border-right: 1px solid var(--navy-border);
      display: flex; flex-direction: column;
      z-index: 100; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar-brand {
      padding: 20px 20px 16px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 12px;
    }
    .sidebar-brand img { height: 38px; width: auto; }
    .sidebar-brand-text { flex: 1; overflow: hidden; }
    .sidebar-brand-text strong {
      display: block; font-family: 'Outfit', sans-serif;
      font-size: 0.92rem; font-weight: 700; color: var(--white);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sidebar-brand-text span {
      font-size: 0.7rem; color: var(--gold); font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em;
    }

    .sidebar-nav {
      flex: 1; padding: 16px 12px; overflow-y: auto;
    }

    .nav-section-label {
      font-size: 0.65rem; font-weight: 600; color: var(--text-dimmed);
      text-transform: uppercase; letter-spacing: 0.1em;
      padding: 8px 8px 6px; margin-bottom: 4px;
    }

    .nav-link {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 12px; border-radius: 10px;
      font-size: 0.9rem; font-weight: 500;
      color: var(--text-muted); text-decoration: none;
      transition: all 0.2s; cursor: pointer; border: none;
      background: none; width: 100%; text-align: left;
    }
    .nav-link i { font-size: 1rem; width: 20px; text-align: center; }
    .nav-link:hover { color: var(--white); background: rgba(255, 255, 255, 0.05); }
    .nav-link.active {
      color: var(--gold); background: rgba(244, 179, 36, 0.12);
      font-weight: 600;
    }
    .nav-link.active i { color: var(--gold); }

    .sidebar-footer {
      padding: 16px 12px;
      border-top: 1px solid var(--border);
    }
    .btn-logout {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 10px;
      font-size: 0.87rem; font-weight: 500;
      color: var(--text-muted); background: none; border: none;
      cursor: pointer; width: 100%; transition: all 0.2s;
    }
    .btn-logout:hover { color: #FCA5A5; background: rgba(239, 68, 68, 0.1); }

    /* ═══════════════════════════════════════════════
       TOP HEADER
    ═══════════════════════════════════════════════ */
    .topbar {
      position: fixed; top: 0;
      left: var(--sidebar-w); right: 0;
      height: var(--header-h);
      background: rgba(13, 21, 48, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center;
      padding: 0 28px; gap: 16px; z-index: 90;
    }
    .hamburger-btn {
      display: none; background: none; border: none;
      color: var(--text-primary); font-size: 1.25rem;
      cursor: pointer; padding: 6px;
    }
    .topbar-title {
      flex: 1; font-family: 'Outfit', sans-serif;
      font-size: 1.15rem; font-weight: 700;
    }
    .topbar-title span { color: var(--gold); }

    .topbar-user {
      display: flex; align-items: center; gap: 10px;
    }
    .topbar-badge {
      display: flex; align-items: center; gap: 6px;
      background: rgba(244, 179, 36, 0.1); border: 1px solid rgba(244, 179, 36, 0.25);
      padding: 5px 12px; border-radius: 20px;
      font-size: 0.78rem; font-weight: 600; color: var(--gold);
    }
    .topbar-badge i { font-size: 0.55rem; color: var(--success); }

    /* ═══════════════════════════════════════════════
       MAIN CONTENT
    ═══════════════════════════════════════════════ */
    .main-content {
      margin-left: var(--sidebar-w);
      padding-top: var(--header-h);
      min-height: 100vh;
    }

    .content-area {
      padding: 28px 32px;
      max-width: 1400px;
      margin: 0 auto;
    }

    /* ═══════════════════════════════════════════════
       STATS ROW
    ═══════════════════════════════════════════════ */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      transition: transform 0.2s, border-color 0.2s;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      border-color: rgba(244, 179, 36, 0.3);
    }
    .stat-icon {
      width: 50px; height: 50px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; flex-shrink: 0;
    }
    .stat-icon.gold { background: rgba(244, 179, 36, 0.15); color: var(--gold); }
    .stat-icon.blue { background: rgba(59, 130, 246, 0.15); color: #60A5FA; }
    .stat-icon.green { background: rgba(16, 185, 129, 0.15); color: var(--success); }
    .stat-info strong {
      display: block; font-family: 'Outfit', sans-serif;
      font-size: 1.6rem; font-weight: 700; color: var(--white); line-height: 1.1;
    }
    .stat-info span {
      font-size: 0.8rem; color: var(--text-muted); font-weight: 500;
    }

    /* ═══════════════════════════════════════════════
       UPLOAD SECTION
    ═══════════════════════════════════════════════ */
    .section-header {
      margin-bottom: 14px;
    }
    .section-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.05rem; font-weight: 700; color: var(--white);
      display: flex; align-items: center; gap: 8px;
    }
    .section-title i { color: var(--gold); font-size: 0.95rem; }

    .upload-zone {
      background: var(--bg-card);
      border: 2px dashed rgba(244, 179, 36, 0.35);
      border-radius: 16px;
      padding: 36px 24px;
      text-align: center;
      cursor: pointer;
      transition: all 0.25s ease;
      position: relative;
      margin-bottom: 28px;
    }
    .upload-zone:hover, .upload-zone.drag-over {
      border-color: var(--gold);
      background: rgba(244, 179, 36, 0.05);
    }
    .upload-zone input[type="file"] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-icon {
      font-size: 2.4rem; color: var(--gold); margin-bottom: 12px;
      transition: transform 0.2s;
    }
    .upload-zone:hover .upload-icon { transform: translateY(-4px); }
    .upload-title {
      font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 600;
      color: var(--white); margin-bottom: 6px;
    }
    .upload-sub {
      font-size: 0.82rem; color: var(--text-muted); margin-bottom: 14px;
    }
    .upload-types {
      display: flex; justify-content: center; gap: 6px;
    }
    .type-badge {
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em;
      padding: 3px 8px; border-radius: 6px;
      background: rgba(255, 255, 255, 0.06); color: var(--text-dimmed);
      border: 1px solid var(--border);
    }

    /* Upload progress bar */
    .upload-progress {
      display: none;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 24px;
    }
    .upload-progress.show { display: block; }
    .progress-label {
      display: flex; justify-content: space-between;
      font-size: 0.83rem; font-weight: 500; color: var(--text-muted);
      margin-bottom: 8px;
    }
    .progress-bar-wrap {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 6px; height: 8px; overflow: hidden;
    }
    .progress-bar {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, var(--gold) 0%, #FBBF24 100%);
      border-radius: 6px; transition: width 0.3s ease;
    }

    /* ═══════════════════════════════════════════════
       GALLERY TOOLBAR
    ═══════════════════════════════════════════════ */
    .gallery-toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .search-wrap {
      position: relative;
      flex: 1;
      min-width: 220px;
    }
    .search-wrap i {
      position: absolute; left: 14px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-dimmed); font-size: 0.88rem;
    }
    .search-input {
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 9px 14px 9px 38px;
      color: var(--text-primary);
      font-size: 0.86rem;
      font-family: inherit;
      outline: none;
      transition: all 0.2s;
    }
    .search-input:focus {
      border-color: var(--gold);
      background: rgba(255, 255, 255, 0.08);
    }
    .search-input::placeholder { color: var(--text-dimmed); }

    .view-toggle {
      display: flex;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 3px;
      gap: 2px;
    }
    .view-btn {
      background: none; border: none;
      color: var(--text-muted);
      padding: 6px 10px; border-radius: 7px;
      cursor: pointer; font-size: 0.85rem;
      transition: all 0.2s;
    }
    .view-btn.active, .view-btn:hover {
      background: rgba(244, 179, 36, 0.15);
      color: var(--gold);
    }

    .btn-action {
      display: flex; align-items: center; gap: 7px;
      padding: 8px 14px; border-radius: 10px;
      font-size: 0.84rem; font-weight: 500; font-family: inherit;
      cursor: pointer; transition: all 0.2s;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-muted);
    }
    .btn-action:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--white);
    }
    .btn-action.select-all-btn:hover {
      border-color: rgba(244, 179, 36, 0.4);
      color: var(--gold);
    }
    .btn-action.delete-selected-btn {
      color: #FCA5A5;
      border-color: rgba(239, 68, 68, 0.3);
      background: rgba(239, 68, 68, 0.08);
      display: none;
    }
    .btn-action.delete-selected-btn.visible { display: flex; }
    .btn-action.delete-selected-btn:hover {
      background: var(--error);
      color: var(--white);
    }
    .btn-action.refresh-btn:hover {
      color: var(--gold);
    }

    /* ═══════════════════════════════════════════════
       GALLERY GRID VIEW
    ═══════════════════════════════════════════════ */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }

    .gallery-item {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      cursor: pointer;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .gallery-item:hover {
      transform: translateY(-3px);
      border-color: rgba(244, 179, 36, 0.4);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    }
    .gallery-item.selected {
      border-color: var(--gold);
      box-shadow: 0 0 0 2px var(--gold);
    }

    .gallery-item .img-thumb-wrap {
      width: 100%; height: 100%; position: relative;
    }
    .gallery-item img.gallery-img {
      width: 100%; height: 100%; object-fit: cover;
      display: block; transition: transform 0.3s;
    }
    .gallery-item:hover img.gallery-img {
      transform: scale(1.04);
    }

    /* Hover overlay on card */
    .item-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(10, 17, 40, 0.4) 0%, rgba(10, 17, 40, 0.85) 100%);
      opacity: 0;
      display: flex; flex-direction: column;
      justify-content: space-between;
      padding: 10px;
      transition: opacity 0.2s ease;
    }
    .gallery-item:hover .item-overlay,
    .gallery-item.selected .item-overlay {
      opacity: 1;
    }

    .overlay-top {
      display: flex; justify-content: space-between; align-items: center;
    }
    .cb-select {
      width: 22px; height: 22px; border-radius: 6px;
      background: rgba(0, 0, 0, 0.5);
      border: 1.5px solid rgba(255, 255, 255, 0.4);
      display: flex; align-items: center; justify-content: center;
      color: transparent; font-size: 0.7rem;
      cursor: pointer; transition: all 0.15s;
    }
    .cb-select.checked, .gallery-item.selected .cb-select {
      background: var(--gold); border-color: var(--gold);
      color: var(--navy);
    }

    .overlay-bottom {
      display: flex; flex-direction: column; gap: 6px;
    }
    .item-filename {
      font-size: 0.76rem; color: var(--white); font-weight: 500;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .overlay-actions {
      display: flex; gap: 6px; justify-content: flex-end;
    }
    .action-btn {
      width: 28px; height: 28px; border-radius: 7px;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--white); font-size: 0.72rem;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.15s;
      text-decoration: none;
    }
    .action-btn:hover {
      background: var(--gold); color: var(--navy); border-color: var(--gold);
    }
    .action-btn.del:hover {
      background: var(--error); color: var(--white); border-color: var(--error);
    }

    /* ═══════════════════════════════════════════════
       GALLERY LIST VIEW
    ═══════════════════════════════════════════════ */
    .gallery-grid.list-view {
      display: flex; flex-direction: column; gap: 8px;
    }
    .gallery-grid.list-view .gallery-item {
      aspect-ratio: unset;
      height: 64px;
      display: flex; align-items: center;
      padding: 8px 14px; gap: 14px;
    }
    .gallery-grid.list-view .img-thumb-wrap {
      width: 48px; height: 48px; flex-shrink: 0;
      border-radius: 8px; overflow: hidden;
    }
    .gallery-grid.list-view .item-overlay { display: none; }
    .gallery-grid.list-view .item-info {
      flex: 1; min-width: 0;
    }
    .gallery-grid.list-view .item-name {
      font-size: 0.88rem; font-weight: 500; color: var(--white);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      display: block; margin-bottom: 2px;
    }
    .gallery-grid.list-view .item-meta {
      font-size: 0.75rem; color: var(--text-dimmed); display: flex; gap: 12px;
    }
    .gallery-grid.list-view .list-actions {
      display: flex; gap: 6px; flex-shrink: 0;
    }
    .gallery-grid.list-view .list-action-btn {
      width: 32px; height: 32px; border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: var(--text-muted); font-size: 0.8rem;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.15s; text-decoration: none;
    }
    .gallery-grid.list-view .list-action-btn:hover {
      background: var(--gold); color: var(--navy); border-color: var(--gold);
    }
    .gallery-grid.list-view .list-action-btn.del:hover {
      background: var(--error); color: var(--white); border-color: var(--error);
    }

    /* ═══════════════════════════════════════════════
       EMPTY & LOADING STATES
    ═══════════════════════════════════════════════ */
    .empty-state {
      text-align: center; padding: 60px 24px; display: none;
    }
    .empty-state.show { display: block; }
    .empty-icon { font-size: 3rem; color: var(--text-dimmed); margin-bottom: 16px; }
    .empty-title { font-family: 'Outfit', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; }
    .empty-sub { font-size: 0.85rem; color: var(--text-dimmed); }

    .loading-spinner {
      text-align: center; padding: 40px; color: var(--gold); font-size: 1.8rem;
    }

    /* ═══════════════════════════════════════════════
       LIGHTBOX PREVIEW
    ═══════════════════════════════════════════════ */
    .lightbox {
      position: fixed; inset: 0; z-index: 9000;
      background: rgba(0, 0, 0, 0.94); backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: none; align-items: center; justify-content: center;
      padding: 24px;
    }
    .lightbox.open { display: flex; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .lb-inner { position: relative; max-width: 90vw; max-height: 88vh; text-align: center; }
    .lb-img { max-width: 100%; max-height: 82vh; border-radius: 12px; object-fit: contain; box-shadow: 0 24px 80px rgba(0, 0, 0, 0.8); }
    .lb-close {
      position: fixed; top: 20px; right: 24px;
      width: 40px; height: 40px; border-radius: 10px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--white); cursor: pointer; font-size: 1.1rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .lb-close:hover { background: rgba(239, 68, 68, 0.3); color: #FCA5A5; }
    .lb-caption {
      margin-top: 14px; text-align: center;
      font-size: 0.88rem; color: rgba(255, 255, 255, 0.7);
    }
    .lb-nav {
      position: fixed; top: 50%; transform: translateY(-50%);
      width: 44px; height: 44px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--white); cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .lb-nav:hover { background: rgba(244, 179, 36, 0.25); border-color: rgba(244, 179, 36, 0.5); }
    .lb-prev { left: 16px; }
    .lb-next { right: 16px; }

    /* ═══════════════════════════════════════════════
       CONFIRM DELETE MODAL
    ═══════════════════════════════════════════════ */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 8000;
      background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none; align-items: center; justify-content: center;
      padding: 16px;
    }
    .modal-overlay.open { display: flex; animation: fadeIn 0.2s ease; }
    .modal-box {
      background: var(--navy-mid); border: 1px solid var(--navy-border);
      border-radius: 16px; padding: 32px 28px; width: 100%; max-width: 400px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
      animation: slideUp 0.25s ease;
    }
    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .modal-icon { font-size: 2.2rem; color: var(--error); margin-bottom: 14px; }
    .modal-title { font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; color: var(--white); }
    .modal-body { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 24px; line-height: 1.5; }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
    .btn-cancel {
      padding: 9px 20px; border-radius: 9px;
      background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border);
      color: var(--text-muted); font-size: 0.88rem; cursor: pointer; transition: all 0.2s;
    }
    .btn-cancel:hover { color: var(--white); background: rgba(255, 255, 255, 0.12); }
    .btn-confirm-del {
      padding: 9px 20px; border-radius: 9px;
      background: var(--error); border: none;
      color: var(--white); font-size: 0.88rem; font-weight: 600;
      cursor: pointer; transition: all 0.2s;
    }
    .btn-confirm-del:hover { background: #DC2626; }

    /* ═══════════════════════════════════════════════
       TOAST NOTIFICATIONS
    ═══════════════════════════════════════════════ */
    .toast {
      position: fixed; bottom: 24px; right: 24px;
      min-width: 280px; max-width: 380px;
      background: var(--navy-mid); border: 1px solid var(--border);
      border-radius: 12px; padding: 14px 18px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
      z-index: 9999; transform: translateY(120%); opacity: 0;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast-icon { font-size: 1.15rem; flex-shrink: 0; }
    .toast-icon.success { color: var(--success); }
    .toast-icon.error   { color: var(--error); }
    .toast-text { font-size: 0.88rem; color: var(--text-primary); font-weight: 500; }

    /* ═══════════════════════════════════════════════
       SIDEBAR OVERLAY (mobile)
    ═══════════════════════════════════════════════ */
    .sidebar-overlay {
      display: none; position: fixed; inset: 0; z-index: 99;
      background: rgba(0, 0, 0, 0.65);
    }
    .sidebar-overlay.show { display: block; }

    /* ═══════════════════════════════════════════════
       RESPONSIVE DESIGN
    ═══════════════════════════════════════════════ */
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .topbar { left: 0; }
      .hamburger-btn { display: block; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .content-area { padding: 20px 16px; }
    }
    @media (max-width: 480px) {
      .stats-row { grid-template-columns: 1fr; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .gallery-toolbar { flex-direction: column; align-items: stretch; }
      .search-wrap { max-width: 100%; }
    }
  </style>
</head>

<body>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar" role="navigation" aria-label="Admin sidebar">
    <div class="sidebar-brand">
      <img src="/images/logo3.webp" alt="Air Prime Asia" onerror="this.src='/assests/images/logo.png'">
      <div class="sidebar-brand-text">
        <strong>Air Prime Asia</strong>
        <span>Admin Panel</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-label">Management</div>
      <a class="nav-link active" id="nav-gallery" href="/admin/panel" role="menuitem" aria-current="page">
        <i class="fas fa-images"></i>
        Photo Gallery
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/admin/logout" class="btn-logout" id="btn-logout" style="text-decoration:none;" aria-label="Logout">
        <i class="fas fa-sign-out-alt"></i>
        Logout
      </a>
    </div>
  </aside>

  <!-- Sidebar mobile overlay -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <!-- Top Bar -->
  <header class="topbar" role="banner">
    <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle sidebar" aria-expanded="false">
      <i class="fas fa-bars"></i>
    </button>
    <div class="topbar-title">Photo Gallery <span>Management</span></div>
    <div class="topbar-user">
      <div class="topbar-badge">
        <i class="fas fa-circle"></i>
        <%= (typeof admin !== 'undefined' && admin && admin.username) ? admin.username : 'Admin' %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content" id="main-content" role="main">
    <div class="content-area">

      <!-- Stats Row -->
      <div class="stats-row" id="stats-row">
        <div class="stat-card">
          <div class="stat-icon gold"><i class="fas fa-images"></i></div>
          <div class="stat-info">
            <strong id="stat-total">0</strong>
            <span>Total Images</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon blue"><i class="fas fa-check-square"></i></div>
          <div class="stat-info">
            <strong id="stat-selected">0</strong>
            <span>Selected</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green"><i class="fas fa-cloud-upload-alt"></i></div>
          <div class="stat-info">
            <strong id="stat-uploaded">0</strong>
            <span>Uploaded Today</span>
          </div>
        </div>
      </div>

      <!-- Upload Section -->
      <div class="section-header">
        <div class="section-title"><i class="fas fa-cloud-upload-alt"></i> Upload Images</div>
      </div>

      <div class="upload-zone" id="upload-zone" role="button" tabindex="0" aria-label="Upload images area">
        <input type="file" id="file-input" multiple accept="image/jpeg,image/png,image/gif,image/webp" aria-label="Select images to upload">
        <div class="upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
        <div class="upload-title">Drag &amp; drop images here</div>
        <div class="upload-sub">or click to browse from your device (Max 5MB per file)</div>
        <div class="upload-types">
          <span class="type-badge">JPG</span>
          <span class="type-badge">PNG</span>
          <span class="type-badge">WEBP</span>
          <span class="type-badge">GIF</span>
        </div>
      </div>

      <!-- Upload Progress -->
      <div class="upload-progress" id="upload-progress">
        <div class="progress-label">
          <span id="progress-text">Uploading images…</span>
          <span id="progress-pct">0%</span>
        </div>
        <div class="progress-bar-wrap">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
      </div>

      <!-- Gallery Section -->
      <div class="section-header">
        <div class="section-title"><i class="fas fa-th"></i> Gallery Images</div>
      </div>

      <!-- Toolbar -->
      <div class="gallery-toolbar">
        <div class="search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" class="search-input" id="search-input" placeholder="Search by name…" aria-label="Search images">
        </div>
        <div class="view-toggle">
          <button class="view-btn active" id="grid-btn" title="Grid view" aria-label="Grid view">
            <i class="fas fa-th"></i>
          </button>
          <button class="view-btn" id="list-btn" title="List view" aria-label="List view">
            <i class="fas fa-list"></i>
          </button>
        </div>
        <button class="btn-action select-all-btn" id="select-all-btn">
          <i class="fas fa-check-square"></i> Select All
        </button>
        <button class="btn-action delete-selected-btn" id="delete-selected-btn">
          <i class="fas fa-trash-alt"></i> Delete Selected (<span id="sel-count">0</span>)
        </button>
        <button class="btn-action refresh-btn" id="refresh-btn" title="Refresh gallery">
          <i class="fas fa-sync-alt" id="refresh-icon"></i>
        </button>
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-grid" id="gallery-grid" aria-label="Image gallery">
        <div class="loading-spinner" id="loading-spinner">
          <i class="fas fa-circle-notch fa-spin"></i>
        </div>
      </div>

      <!-- Empty State -->
      <div class="empty-state" id="empty-state">
        <div class="empty-icon"><i class="fas fa-images"></i></div>
        <div class="empty-title">No images in gallery</div>
        <div class="empty-sub">Upload images above to store them in database and display on the Photo Gallery page.</div>
      </div>

    </div>
  </main>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview">
    <button class="lb-close" id="lb-close" aria-label="Close preview"><i class="fas fa-times"></i></button>
    <button class="lb-nav lb-prev" id="lb-prev" aria-label="Previous image"><i class="fas fa-chevron-left"></i></button>
    <div class="lb-inner">
      <img class="lb-img" id="lb-img" src="" alt="Preview">
      <div class="lb-caption" id="lb-caption"></div>
    </div>
    <button class="lb-nav lb-next" id="lb-next" aria-label="Next image"><i class="fas fa-chevron-right"></i></button>
  </div>

  <!-- Confirm Delete Modal -->
  <div class="modal-overlay" id="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
      <div class="modal-icon"><i class="fas fa-trash-alt"></i></div>
      <div class="modal-title" id="modal-title">Delete Image(s)?</div>
      <div class="modal-body" id="modal-body">Are you sure you want to delete the selected image(s)? This will remove them permanently.</div>
      <div class="modal-actions">
        <button class="btn-cancel" id="modal-cancel">Cancel</button>
        <button class="btn-confirm-del" id="modal-confirm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast" id="toast" role="status" aria-live="polite">
    <i class="toast-icon" id="toast-icon"></i>
    <span class="toast-text" id="toast-text"></span>
  </div>

  <script>
    'use strict';

    // ─── State ────────────────────────────────────────────────────────
    var images = [];          // Loaded from /api/gallery/images
    var selectedIds = new Set();
    var currentLbIndex = -1;
    var searchQuery = '';
    var isListView = false;
    var uploadedToday = 0;
    var deleteCallback = null;

    // ─── Fetch Images from API ────────────────────────────────────────
    async function fetchImages(silent) {
      if (!silent) {
        var spin = document.getElementById('loading-spinner');
        if (spin) spin.style.display = 'block';
      }

      try {
        var res = await fetch('/api/gallery/images');
        var data = await res.json();

        if (res.ok && data.success) {
          images = data.images || [];
          // Retain only selected IDs that still exist in current view
          var currentIds = new Set(images.map(function(img) { return img.id; }));
          selectedIds.forEach(function(id) {
            if (!currentIds.has(id)) selectedIds.delete(id);
          });
          calculateUploadedToday();
          render();
        } else {
          showToast('error', data.message || 'Failed to load gallery images.');
        }
      } catch (err) {
        console.error('Error fetching images:', err);
        showToast('error', 'Network error fetching images.');
      } finally {
        var spin = document.getElementById('loading-spinner');
        if (spin) spin.style.display = 'none';
      }
    }

    function calculateUploadedToday() {
      var todayStr = new Date().toDateString();
      uploadedToday = images.filter(function (img) {
        if (!img.createdAt) return false;
        return new Date(img.createdAt).toDateString() === todayStr;
      }).length;
    }

    // ─── Render ────────────────────────────────────────────────────────
    function getFilteredImages() {
      if (!searchQuery) return images;
      var q = searchQuery.toLowerCase();
      return images.filter(function (img) {
        var name = (img.originalName || img.title || '').toLowerCase();
        return name.includes(q);
      });
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        var d = new Date(dateStr);
        return d.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
      } catch(e) {
        return dateStr;
      }
    }

    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      var k = 1024;
      var sizes = ['B', 'KB', 'MB', 'GB'];
      var i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function render() {
      var filtered = getFilteredImages();
      var grid = document.getElementById('gallery-grid');
      var empty = document.getElementById('empty-state');

      // Update statistics
      document.getElementById('stat-total').textContent = images.length;
      document.getElementById('stat-selected').textContent = selectedIds.size;
      document.getElementById('stat-uploaded').textContent = uploadedToday;

      // Update delete selected button state
      var delBtn = document.getElementById('delete-selected-btn');
      document.getElementById('sel-count').textContent = selectedIds.size;
      if (selectedIds.size > 0) {
        delBtn.classList.add('visible');
      } else {
        delBtn.classList.remove('visible');
      }

      if (filtered.length === 0) {
        grid.innerHTML = '';
        empty.classList.add('show');
        return;
      }
      empty.classList.remove('show');

      grid.innerHTML = '';
      filtered.forEach(function (img) {
        var isSelected = selectedIds.has(img.id);
        var el = document.createElement('div');
        el.className = 'gallery-item' + (isSelected ? ' selected' : '');
        el.dataset.id = img.id;
        var displayName = img.originalName || img.title || 'Untitled Image';
        var dateFormatted = formatDate(img.createdAt);
        var sizeFormatted = formatBytes(img.fileSize);

        if (isListView) {
          el.innerHTML =
            '<div class="img-thumb-wrap">' +
              '<img class="gallery-img" src="' + img.filePath + '" alt="' + esc(displayName) + '" loading="lazy" onerror="this.src=\'/images/logo3.webp\'">' +
            '</div>' +
            '<div class="item-info">' +
              '<span class="item-name">' + esc(displayName) + '</span>' +
              '<div class="item-meta">' +
                '<span><i class="far fa-calendar-alt"></i> ' + dateFormatted + '</span>' +
                '<span><i class="fas fa-database"></i> ' + sizeFormatted + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="list-actions">' +
              '<a class="list-action-btn" href="' + img.filePath + '" target="_blank" rel="noopener noreferrer" title="Open in new tab"><i class="fas fa-external-link-alt"></i></a>' +
              '<button class="list-action-btn preview-btn" data-id="' + img.id + '" title="Preview"><i class="fas fa-eye"></i></button>' +
              '<button class="list-action-btn del delete-btn" data-id="' + img.id + '" title="Delete"><i class="fas fa-trash"></i></button>' +
            '</div>';
        } else {
          el.innerHTML =
            '<div class="img-thumb-wrap">' +
              '<img class="gallery-img" src="' + img.filePath + '" alt="' + esc(displayName) + '" loading="lazy" onerror="this.src=\'/images/logo3.webp\'">' +
              '<div class="item-overlay">' +
                '<div class="overlay-top">' +
                  '<div class="cb-select' + (isSelected ? ' checked' : '') + '" data-id="' + img.id + '" role="checkbox" aria-checked="' + isSelected + '" tabindex="0"><i class="fas fa-check"></i></div>' +
                '</div>' +
                '<div class="overlay-bottom">' +
                  '<span class="item-filename" title="' + esc(displayName) + '">' + esc(displayName) + '</span>' +
                  '<div class="overlay-actions">' +
                    '<a class="action-btn" href="' + img.filePath + '" target="_blank" rel="noopener noreferrer" title="Open in new tab"><i class="fas fa-external-link-alt"></i></a>' +
                    '<button class="action-btn preview-btn" data-id="' + img.id + '" title="Preview"><i class="fas fa-eye"></i></button>' +
                    '<button class="action-btn del delete-btn" data-id="' + img.id + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>';
        }

        grid.appendChild(el);
      });

      // Bind events
      grid.querySelectorAll('.cb-select').forEach(function (cb) {
        cb.addEventListener('click', function (e) { e.stopPropagation(); toggleSelect(cb.dataset.id); });
        cb.addEventListener('keydown', function (e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggleSelect(cb.dataset.id); } });
      });
      grid.querySelectorAll('.preview-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) { e.stopPropagation(); openLightbox(btn.dataset.id); });
      });
      grid.querySelectorAll('.delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) { e.stopPropagation(); confirmDelete([btn.dataset.id], 'Delete Image?', 'Are you sure you want to permanently delete this image?'); });
      });
      grid.querySelectorAll('.gallery-item').forEach(function (item) {
        item.addEventListener('click', function () {
          if (isListView) { openLightbox(item.dataset.id); }
          else { toggleSelect(item.dataset.id); }
        });
      });
    }

    function esc(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ─── Select & Select All ──────────────────────────────────────────
    function toggleSelect(id) {
      if (selectedIds.has(id)) { selectedIds.delete(id); } else { selectedIds.add(id); }
      render();
    }

    document.getElementById('select-all-btn').addEventListener('click', function () {
      var filtered = getFilteredImages();
      if (selectedIds.size === filtered.length && filtered.length > 0) {
        selectedIds.clear();
      } else {
        filtered.forEach(function (img) { selectedIds.add(img.id); });
      }
      render();
    });

    // ─── Delete Operations ────────────────────────────────────────────
    function confirmDelete(ids, title, body) {
      document.getElementById('modal-title').textContent = title;
      document.getElementById('modal-body').textContent = body;
      document.getElementById('modal-overlay').classList.add('open');
      deleteCallback = function () { doDelete(ids); };
    }

    document.getElementById('modal-cancel').addEventListener('click', closeModal);
    document.getElementById('modal-overlay').addEventListener('click', function (e) { if (e.target === this) closeModal(); });
    document.getElementById('modal-confirm').addEventListener('click', function () {
      closeModal();
      if (deleteCallback) { deleteCallback(); deleteCallback = null; }
    });

    function closeModal() { document.getElementById('modal-overlay').classList.remove('open'); }

    async function doDelete(ids) {
      if (!ids || ids.length === 0) return;

      try {
        var res;
        if (ids.length === 1) {
          res = await fetch('/api/gallery/images/' + ids[0], { method: 'DELETE' });
        } else {
          res = await fetch('/api/gallery/images', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: ids }),
          });
        }

        var data = await res.json();
        if (res.ok && data.success) {
          images = images.filter(function (img) { return !ids.includes(img.id); });
          ids.forEach(function (id) { selectedIds.delete(id); });
          calculateUploadedToday();
          render();
          showToast('success', data.message || 'Image(s) deleted successfully.');
        } else {
          showToast('error', data.message || 'Failed to delete image(s).');
        }
      } catch (err) {
        console.error('Delete error:', err);
        showToast('error', 'Error deleting image(s). Please try again.');
      }
    }

    document.getElementById('delete-selected-btn').addEventListener('click', function () {
      if (selectedIds.size === 0) return;
      var ids = Array.from(selectedIds);
      confirmDelete(ids, 'Delete ' + ids.length + ' image(s)?', 'Are you sure you want to permanently delete the ' + ids.length + ' selected image(s)?');
    });

    // ─── Upload Handling ──────────────────────────────────────────────
    var fileInput = document.getElementById('file-input');
    var uploadZone = document.getElementById('upload-zone');

    uploadZone.addEventListener('dragover', function (e) { e.preventDefault(); uploadZone.classList.add('drag-over'); });
    uploadZone.addEventListener('dragleave', function () { uploadZone.classList.remove('drag-over'); });
    uploadZone.addEventListener('drop', function (e) {
      e.preventDefault(); uploadZone.classList.remove('drag-over');
      uploadFiles(e.dataTransfer.files);
    });
    uploadZone.addEventListener('keydown', function (e) {
      if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); fileInput.click(); }
    });

    fileInput.addEventListener('change', function () { uploadFiles(this.files); });

    async function uploadFiles(files) {
      if (!files || files.length === 0) return;
      var validFiles = Array.from(files).filter(function (f) { return f.type.startsWith('image/'); });
      if (validFiles.length === 0) {
        showToast('error', 'Please select valid image files (JPG, PNG, GIF, WEBP).');
        return;
      }

      var progress = document.getElementById('upload-progress');
      var bar = document.getElementById('progress-bar');
      var pct = document.getElementById('progress-pct');
      var txt = document.getElementById('progress-text');
      progress.classList.add('show');
      bar.style.width = '30%';
      pct.textContent = '30%';
      txt.textContent = 'Uploading ' + validFiles.length + ' file(s)...';

      var formData = new FormData();
      validFiles.forEach(function (file) {
        formData.append('images', file);
      });

      try {
        bar.style.width = '65%';
        pct.textContent = '65%';

        var res = await fetch('/api/gallery/upload', {
          method: 'POST',
          body: formData,
        });

        var data = await res.json();
        bar.style.width = '100%';
        pct.textContent = '100%';

        if (res.ok && data.success) {
          showToast('success', data.message || 'Upload completed successfully.');
          await fetchImages(true);
        } else {
          showToast('error', data.message || 'Upload failed.');
        }
      } catch (err) {
        console.error('Upload error:', err);
        showToast('error', 'Upload error occurred.');
      } finally {
        setTimeout(function () {
          progress.classList.remove('show');
          bar.style.width = '0%';
        }, 800);
        fileInput.value = '';
      }
    }

    // ─── Search Input ─────────────────────────────────────────────────
    document.getElementById('search-input').addEventListener('input', function () {
      searchQuery = this.value.trim();
      render();
    });

    // ─── View Toggle ──────────────────────────────────────────────────
    document.getElementById('grid-btn').addEventListener('click', function () {
      isListView = false;
      document.getElementById('gallery-grid').classList.remove('list-view');
      this.classList.add('active');
      document.getElementById('list-btn').classList.remove('active');
      render();
    });
    document.getElementById('list-btn').addEventListener('click', function () {
      isListView = true;
      document.getElementById('gallery-grid').classList.add('list-view');
      this.classList.add('active');
      document.getElementById('grid-btn').classList.remove('active');
      render();
    });

    // ─── Manual Refresh ───────────────────────────────────────────────
    document.getElementById('refresh-btn').addEventListener('click', function () {
      var icon = document.getElementById('refresh-icon');
      icon.classList.add('fa-spin');
      fetchImages(true).then(function () {
        setTimeout(function () { icon.classList.remove('fa-spin'); }, 500);
        showToast('success', 'Gallery refreshed.');
      });
    });

    // ─── Lightbox ─────────────────────────────────────────────────────
    function openLightbox(id) {
      var filtered = getFilteredImages();
      currentLbIndex = filtered.findIndex(function (img) { return img.id === id; });
      showLightboxItem(currentLbIndex);
    }

    function showLightboxItem(idx) {
      var filtered = getFilteredImages();
      if (idx < 0 || idx >= filtered.length) return;
      currentLbIndex = idx;
      var item = filtered[idx];
      var name = item.originalName || item.title || 'Preview';
      document.getElementById('lb-img').src = item.filePath;
      document.getElementById('lb-img').alt = name;
      document.getElementById('lb-caption').textContent = name + ' (' + (idx + 1) + ' of ' + filtered.length + ')';
      document.getElementById('lightbox').classList.add('open');
    }

    document.getElementById('lb-close').addEventListener('click', closeLightbox);
    document.getElementById('lightbox').addEventListener('click', function (e) { if (e.target === this) closeLightbox(); });
    document.getElementById('lb-prev').addEventListener('click', function () { showLightboxItem(currentLbIndex - 1); });
    document.getElementById('lb-next').addEventListener('click', function () { showLightboxItem(currentLbIndex + 1); });

    document.addEventListener('keydown', function (e) {
      var lb = document.getElementById('lightbox');
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') { closeLightbox(); }
      if (e.key === 'ArrowLeft') { showLightboxItem(currentLbIndex - 1); }
      if (e.key === 'ArrowRight') { showLightboxItem(currentLbIndex + 1); }
    });

    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('open');
      document.getElementById('lb-img').src = '';
    }

    // ─── Toast System ─────────────────────────────────────────────────
    var toastTimer = null;
    function showToast(type, msg) {
      var t = document.getElementById('toast');
      var icon = document.getElementById('toast-icon');
      var text = document.getElementById('toast-text');
      icon.className = 'toast-icon ' + type;
      icon.innerHTML = type === 'success' ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-times-circle"></i>';
      text.textContent = msg;
      t.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { t.classList.remove('show'); }, 3500);
    }

    // ─── Mobile Sidebar Toggle ────────────────────────────────────────
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('sidebar-overlay');
    var hbBtn   = document.getElementById('hamburger-btn');

    hbBtn.addEventListener('click', function () {
      var open = sidebar.classList.toggle('open');
      overlay.classList.toggle('show', open);
      hbBtn.setAttribute('aria-expanded', open);
    });
    overlay.addEventListener('click', function () {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      hbBtn.setAttribute('aria-expanded', 'false');
    });

    // ─── Initialization & Auto-Refresh every 60 seconds ───────────────
    fetchImages();
    setInterval(function () {
      fetchImages(true);
    }, 60000);
  </script>

</body>
</html>

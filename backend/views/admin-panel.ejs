<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Panel — Gallery | Air Prime Asia' %></title>
  <meta name="description" content="Admin gallery management panel for Air Prime Asia.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:         #0A1128;
      --navy-mid:     #101E42;
      --navy-light:   #172B5E;
      --navy-border:  #1E2D56;
      --gold:         #F4B324;
      --gold-dark:    #D49B1A;
      --white:        #FFFFFF;
      --bg-page:      #0D1530;
      --bg-card:      rgba(16, 30, 66, 0.85);
      --text-primary: #E8ECF4;
      --text-muted:   #8A95AD;
      --text-dimmed:  #5A647B;
      --border:       rgba(255, 255, 255, 0.08);
      --success:      #10B981;
      --error:        #EF4444;
      --sidebar-w:    240px;
      --header-h:     64px;
    }

    html, body {
      height: 100%;
      font-family: 'Inter', sans-serif;
      background: var(--bg-page);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* ═══════════════════════════════════════════════
       SIDEBAR
    ═══════════════════════════════════════════════ */
    .sidebar {
      position: fixed; top: 0; left: 0; bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, var(--navy-mid) 0%, var(--navy) 100%);
      border-right: 1px solid var(--navy-border);
      display: flex; flex-direction: column;
      z-index: 100; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar-brand {
      padding: 20px 20px 16px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 12px;
    }
    .sidebar-brand img { height: 38px; width: auto; }
    .sidebar-brand-text { flex: 1; overflow: hidden; }
    .sidebar-brand-text strong {
      display: block; font-family: 'Outfit', sans-serif;
      font-size: 0.92rem; font-weight: 700; color: var(--white);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sidebar-brand-text span {
      font-size: 0.7rem; color: var(--gold); font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.08em;
    }

    .sidebar-nav {
      flex: 1; padding: 16px 12px; overflow-y: auto;
    }

    .nav-section-label {
      font-size: 0.65rem; font-weight: 600; color: var(--text-dimmed);
      text-transform: uppercase; letter-spacing: 0.1em;
      padding: 8px 8px 6px; margin-bottom: 4px;
    }

    .nav-link {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 12px; border-radius: 10px;
      font-size: 0.9rem; font-weight: 500;
      color: var(--text-muted); text-decoration: none;
      transition: all 0.2s; cursor: pointer; border: none;
      background: none; width: 100%; text-align: left;
    }
    .nav-link i { font-size: 1rem; width: 20px; text-align: center; }
    .nav-link:hover { color: var(--white); background: rgba(255, 255, 255, 0.05); }
    .nav-link.active {
      color: var(--gold); background: rgba(244, 179, 36, 0.12);
      font-weight: 600;
    }
    .nav-link.active i { color: var(--gold); }

    .sidebar-footer {
      padding: 16px 12px;
      border-top: 1px solid var(--border);
    }
    .btn-logout {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 10px;
      font-size: 0.87rem; font-weight: 500;
      color: var(--text-muted); background: none; border: none;
      cursor: pointer; width: 100%; transition: all 0.2s;
    }
    .btn-logout:hover { color: #FCA5A5; background: rgba(239, 68, 68, 0.1); }

    /* ═══════════════════════════════════════════════
       TOP HEADER
    ═══════════════════════════════════════════════ */
    .topbar {
      position: fixed; top: 0;
      left: var(--sidebar-w); right: 0;
      height: var(--header-h);
      background: rgba(13, 21, 48, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center;
      padding: 0 28px; gap: 16px; z-index: 90;
    }
    .hamburger-btn {
      display: none; background: none; border: none;
      color: var(--text-primary); font-size: 1.25rem;
      cursor: pointer; padding: 6px;
    }
    .topbar-title {
      flex: 1; font-family: 'Outfit', sans-serif;
      font-size: 1.15rem; font-weight: 700;
    }
    .topbar-title span { color: var(--gold); }

    .topbar-user {
      display: flex; align-items: center; gap: 10px;
    }
    .topbar-badge {
      display: flex; align-items: center; gap: 6px;
      background: rgba(244, 179, 36, 0.1); border: 1px solid rgba(244, 179, 36, 0.25);
      padding: 5px 12px; border-radius: 20px;
      font-size: 0.78rem; font-weight: 600; color: var(--gold);
    }
    .topbar-badge i { font-size: 0.55rem; color: var(--success); }

    /* ═══════════════════════════════════════════════
       MAIN CONTENT
    ═══════════════════════════════════════════════ */
    .main-content {
      margin-left: var(--sidebar-w);
      padding-top: var(--header-h);
      min-height: 100vh;
    }

    .content-area {
      padding: 32px 28px;
      max-width: 1400px;
      margin: 0 auto;
    }

    /* ═══════════════════════════════════════════════
       STATS ROW
    ═══════════════════════════════════════════════ */
    .stats-row {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 16px; margin-bottom: 28px;
    }
    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px; padding: 20px 22px;
      display: flex; align-items: center; gap: 16px;
      backdrop-filter: blur(8px);
    }
    .stat-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; flex-shrink: 0;
    }
    .stat-icon.gold  { background: rgba(244, 179, 36, 0.15); color: var(--gold); }
    .stat-icon.blue  { background: rgba(59, 130, 246, 0.15); color: #60A5FA; }
    .stat-icon.green { background: rgba(16, 185, 129, 0.15); color: #34D399; }
    .stat-info strong {
      display: block; font-family: 'Outfit', sans-serif;
      font-size: 1.6rem; font-weight: 700; color: var(--white); line-height: 1.1;
    }
    .stat-info span { font-size: 0.8rem; color: var(--text-muted); }

    /* ═══════════════════════════════════════════════
       UPLOAD ZONE
    ═══════════════════════════════════════════════ */
    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 18px;
    }
    .section-title {
      font-family: 'Outfit', sans-serif; font-size: 1.1rem;
      font-weight: 700; color: var(--white); display: flex; align-items: center; gap: 8px;
    }
    .section-title i { color: var(--gold); font-size: 1rem; }

    .upload-zone {
      border: 2px dashed rgba(244, 179, 36, 0.35);
      border-radius: 16px; padding: 36px 24px;
      text-align: center; cursor: pointer;
      background: rgba(244, 179, 36, 0.025);
      transition: all 0.25s; margin-bottom: 28px;
      position: relative; overflow: hidden;
    }
    .upload-zone:hover, .upload-zone.drag-over {
      border-color: var(--gold);
      background: rgba(244, 179, 36, 0.08);
      transform: scale(1.003);
    }
    .upload-zone input[type="file"] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-icon { font-size: 2.6rem; color: var(--gold); opacity: 0.85; margin-bottom: 12px; }
    .upload-title { font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 600; color: var(--white); margin-bottom: 6px; }
    .upload-sub { font-size: 0.84rem; color: var(--text-muted); }
    .upload-types {
      margin-top: 14px; display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    }
    .type-badge {
      padding: 3px 10px; border-radius: 20px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      font-size: 0.72rem; color: var(--text-muted); font-weight: 500;
    }

    /* ═══════════════════════════════════════════════
       PROGRESS BAR
    ═══════════════════════════════════════════════ */
    .upload-progress {
      display: none; margin-bottom: 24px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px 20px;
    }
    .upload-progress.show { display: block; }
    .progress-label {
      font-size: 0.84rem; color: var(--text-muted); margin-bottom: 10px;
      display: flex; justify-content: space-between;
    }
    .progress-bar-wrap { height: 6px; background: rgba(255, 255, 255, 0.08); border-radius: 99px; overflow: hidden; }
    .progress-bar { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-dark)); border-radius: 99px; width: 0%; transition: width 0.2s; }

    /* ═══════════════════════════════════════════════
       GALLERY TOOLBAR
    ═══════════════════════════════════════════════ */
    .gallery-toolbar {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .search-wrap { position: relative; flex: 1; min-width: 200px; max-width: 360px; }
    .search-wrap i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--text-dimmed); font-size: 0.85rem; }
    .search-input {
      width: 100%; padding: 9px 14px 9px 38px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 10px; color: var(--white);
      font-size: 0.88rem; font-family: 'Inter', sans-serif;
      outline: none; transition: all 0.2s;
    }
    .search-input::placeholder { color: var(--text-dimmed); }
    .search-input:focus { border-color: rgba(244, 179, 36, 0.4); background: rgba(244, 179, 36, 0.03); }

    .view-toggle {
      display: flex; gap: 4px; background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border); border-radius: 10px; padding: 4px;
    }
    .view-btn {
      width: 34px; height: 34px; border-radius: 7px;
      background: none; border: none; color: var(--text-dimmed);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; transition: all 0.2s;
    }
    .view-btn.active { background: rgba(244, 179, 36, 0.15); color: var(--gold); }
    .view-btn:hover:not(.active) { color: var(--text-primary); background: rgba(255, 255, 255, 0.04); }

    .btn-action {
      padding: 8px 16px; border-radius: 10px;
      font-size: 0.85rem; font-weight: 500; cursor: pointer;
      transition: all 0.2s; border: 1px solid var(--border);
      display: flex; align-items: center; gap: 6px;
    }
    .select-all-btn { background: rgba(255, 255, 255, 0.05); color: var(--text-muted); }
    .select-all-btn:hover { background: rgba(255, 255, 255, 0.09); color: var(--white); }
    .delete-selected-btn {
      background: rgba(239, 68, 68, 0.12); color: #FCA5A5;
      border-color: rgba(239, 68, 68, 0.25); display: none;
    }
    .delete-selected-btn:hover { background: rgba(239, 68, 68, 0.25); }
    .delete-selected-btn.visible { display: flex; }

    .refresh-btn {
      background: rgba(255, 255, 255, 0.05); color: var(--text-muted);
      width: 36px; height: 36px; padding: 0; justify-content: center;
    }
    .refresh-btn:hover { color: var(--gold); }

    /* ═══════════════════════════════════════════════
       GALLERY GRID
    ═══════════════════════════════════════════════ */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 16px;
    }
    .gallery-grid.list-view {
      grid-template-columns: 1fr; gap: 10px;
    }

    .gallery-item {
      position: relative; border-radius: 12px; overflow: hidden;
      background: rgba(16, 30, 66, 0.6); border: 1px solid var(--border);
      cursor: pointer; transition: all 0.25s;
    }
    .gallery-item:hover { border-color: rgba(244, 179, 36, 0.35); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
    .gallery-item.selected { border-color: var(--gold); box-shadow: 0 0 0 2px rgba(244, 179, 36, 0.35); }

    .gallery-grid:not(.list-view) .gallery-item {
      aspect-ratio: 1;
    }

    .img-thumb-wrap { position: relative; width: 100%; height: 100%; overflow: hidden; background: #070D1E; }

    .gallery-img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform 0.35s ease;
    }
    .gallery-grid:not(.list-view) .gallery-item:hover .gallery-img { transform: scale(1.06); }

    /* list view item */
    .gallery-grid.list-view .gallery-item {
      display: flex; align-items: center; gap: 14px;
      padding: 12px 16px; aspect-ratio: unset;
    }
    .gallery-grid.list-view .img-thumb-wrap {
      width: 56px; height: 56px; border-radius: 8px; overflow: hidden; flex-shrink: 0;
    }
    .gallery-grid.list-view .gallery-img { width: 56px; height: 56px; border-radius: 8px; }
    .gallery-grid.list-view .item-overlay { display: none; }
    .gallery-grid.list-view .item-info { flex: 1; min-width: 0; }
    .gallery-grid.list-view .item-name {
      display: block; font-size: 0.9rem; color: var(--white); font-weight: 500;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .gallery-grid.list-view .item-meta { display: flex; gap: 16px; margin-top: 3px; }
    .gallery-grid.list-view .item-meta span { font-size: 0.75rem; color: var(--text-dimmed); }
    .gallery-grid.list-view .list-actions { display: flex; gap: 8px; }

    .item-name { display: none; }
    .item-info { display: none; }
    .list-actions { display: none; }

    /* overlay on grid view */
    .item-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10, 17, 40, 0.9) 0%, rgba(0, 0, 0, 0.2) 40%, transparent 70%);
      opacity: 0; transition: opacity 0.25s;
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 10px;
    }
    .gallery-item:hover .item-overlay { opacity: 1; }

    .overlay-top { display: flex; justify-content: flex-end; }
    .overlay-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

    .cb-select {
      width: 22px; height: 22px; border-radius: 6px;
      border: 2px solid rgba(255, 255, 255, 0.7);
      background: rgba(0, 0, 0, 0.5); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s; flex-shrink: 0;
    }
    .gallery-item.selected .cb-select,
    .cb-select.checked {
      background: var(--gold); border-color: var(--gold);
    }
    .cb-select i { font-size: 0.7rem; color: var(--navy); display: none; }
    .gallery-item.selected .cb-select i,
    .cb-select.checked i { display: block; }

    .item-filename {
      font-size: 0.75rem; color: rgba(255, 255, 255, 0.9);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      max-width: 100px; font-weight: 500;
    }

    .overlay-actions { display: flex; gap: 6px; }
    .action-btn {
      width: 30px; height: 30px; border-radius: 8px;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--white); cursor: pointer; font-size: 0.8rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s; text-decoration: none;
    }
    .action-btn:hover { background: rgba(255, 255, 255, 0.3); color: var(--white); }
    .action-btn.del { background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.3); color: #FCA5A5; }
    .action-btn.del:hover { background: rgba(239, 68, 68, 0.4); }

    /* list view inline action btns */
    .list-action-btn {
      width: 34px; height: 34px; border-radius: 8px;
      border: 1px solid var(--border); background: rgba(255, 255, 255, 0.04);
      color: var(--text-muted); cursor: pointer; font-size: 0.85rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s; text-decoration: none;
    }
    .list-action-btn:hover { color: var(--white); border-color: rgba(255, 255, 255, 0.2); }
    .list-action-btn.del { color: #FCA5A5; border-color: rgba(239, 68, 68, 0.25); }
    .list-action-btn.del:hover { background: rgba(239, 68, 68, 0.15); }

    /* Quick Tag Mode button */
    .btn-action.quick-tag-btn {
      background: linear-gradient(135deg, rgba(244,179,36,0.2) 0%, rgba(244,179,36,0.1) 100%);
      border-color: rgba(244, 179, 36, 0.6);
      color: var(--gold);
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .btn-action.quick-tag-btn:hover {
      background: var(--gold);
      color: var(--navy);
      box-shadow: 0 0 18px rgba(244, 179, 36, 0.35);
    }

    /* ═══════════════════════════════════════════════
       QUICK TAG MODE MODAL
    ═══════════════════════════════════════════════ */
    .qtm-overlay {
      position: fixed; inset: 0; z-index: 10000;
      background: linear-gradient(160deg, #080e22 0%, #0a1128 60%, #0d1940 100%);
      display: none; flex-direction: column;
      overflow: hidden;
    }
    .qtm-overlay.open { display: flex; animation: fadeIn 0.25s ease; }

    /* Header bar */
    .qtm-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 24px;
      border-bottom: 1px solid rgba(244,179,36,0.2);
      background: rgba(10,17,40,0.95);
      flex-shrink: 0;
    }
    .qtm-progress {
      font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 700;
      color: var(--gold);
      background: rgba(244,179,36,0.1);
      border: 1px solid rgba(244,179,36,0.3);
      border-radius: 8px; padding: 5px 14px;
    }
    .qtm-title {
      font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 700;
      color: var(--white); letter-spacing: 0.03em;
    }
    .qtm-close {
      background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      color: var(--text-muted); border-radius: 9px;
      padding: 7px 16px; font-size: 0.88rem; cursor: pointer;
      transition: all 0.2s; font-family: inherit;
    }
    .qtm-close:hover { background: rgba(239,68,68,0.2); color: #FCA5A5; border-color: rgba(239,68,68,0.4); }

    /* Stage (image area) */
    .qtm-stage {
      flex: 1; display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 12px;
      padding: 24px 24px 12px;
      min-height: 0;
    }
    .qtm-loading, .qtm-done {
      text-align: center; color: var(--text-muted);
    }
    .qtm-loading i { font-size: 2.5rem; color: var(--gold); margin-bottom: 14px; display: block; }
    .qtm-loading p { font-size: 1rem; }

    .qtm-done-icon { font-size: 3.5rem; margin-bottom: 16px; }
    .qtm-done-title {
      font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 700;
      color: var(--white); margin-bottom: 8px;
    }
    .qtm-done-sub { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 28px; }
    .qtm-done-close {
      background: var(--gold); border: none; color: var(--navy);
      font-weight: 700; font-size: 1rem; padding: 12px 36px;
      border-radius: 10px; cursor: pointer; transition: all 0.2s;
      font-family: inherit;
    }
    .qtm-done-close:hover { background: var(--gold-dark); }

    /* Image viewer */
    .qtm-viewer {
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; width: 100%; min-height: 0; flex: 1;
    }
    .qtm-img-wrap {
      flex: 1; min-height: 0; width: 100%;
      display: flex; align-items: center; justify-content: center;
    }
    .qtm-img {
      max-height: 70vh; max-width: 100%;
      object-fit: contain; border-radius: 10px;
      box-shadow: 0 20px 70px rgba(0,0,0,0.7);
      transition: opacity 0.2s ease;
    }
    .qtm-img.fading { opacity: 0; }
    .qtm-filename {
      font-size: 0.82rem; color: var(--text-dimmed);
      text-align: center; max-width: 600px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .qtm-kbd-hint {
      font-size: 0.75rem; color: var(--text-dimmed);
      margin-top: 2px;
    }
    .qtm-kbd-hint kbd {
      display: inline-block; background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 4px; padding: 1px 5px;
      font-size: 0.72rem; font-family: inherit;
    }

    /* Category action buttons */
    .qtm-actions {
      display: flex; flex-wrap: wrap; gap: 10px;
      justify-content: center; padding: 14px 24px 20px;
      flex-shrink: 0;
      border-top: 1px solid rgba(255,255,255,0.05);
      background: rgba(10,17,40,0.8);
    }
    .qtm-cat-btn {
      display: flex; align-items: center; gap: 8px;
      padding: 12px 20px; border-radius: 10px;
      border: 1px solid rgba(244,179,36,0.45);
      background: rgba(244,179,36,0.07);
      color: var(--text-primary);
      font-family: 'Outfit', sans-serif; font-size: 0.92rem; font-weight: 600;
      cursor: pointer; transition: all 0.15s; flex-shrink: 0;
    }
    .qtm-cat-btn:hover {
      background: var(--gold); color: var(--navy);
      border-color: var(--gold);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(244,179,36,0.3);
    }
    .qtm-cat-btn:active { transform: translateY(0); }
    .qtm-skip-btn {
      border-color: rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.04);
      color: var(--text-muted);
    }
    .qtm-skip-btn:hover {
      background: rgba(255,255,255,0.1);
      color: var(--white); border-color: rgba(255,255,255,0.3);
    }
    .qtm-key {
      display: inline-flex; align-items: center; justify-content: center;
      width: 20px; height: 20px; border-radius: 5px;
      background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.2);
      font-size: 0.68rem; font-family: monospace; flex-shrink: 0;
    }
    .qtm-cat-btn:hover .qtm-key {
      background: rgba(10,17,40,0.5); border-color: rgba(10,17,40,0.3);
    }
    @media (max-width: 640px) {
      .qtm-cat-btn { padding: 10px 14px; font-size: 0.82rem; }
      .qtm-actions { gap: 8px; padding: 12px 12px 16px; }
      .qtm-key { display: none; }
    }

    /* Page Select Dropdowns & Bulk Actions */
    .filter-page-select, .bulk-page-select, .upload-page-select {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: var(--text-primary);
      border-radius: 9px;
      padding: 8px 12px;
      font-size: 0.84rem;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-page-select:focus, .bulk-page-select:focus, .upload-page-select:focus {
      border-color: var(--gold);
      background: rgba(16, 30, 66, 0.95);
    }
    .filter-page-select option, .bulk-page-select option, .upload-page-select option {
      background: var(--navy-mid);
      color: var(--text-primary);
    }
    .bulk-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .btn-action.apply-bulk-btn {
      background: rgba(244, 179, 36, 0.15);
      border-color: rgba(244, 179, 36, 0.4);
      color: var(--gold);
    }
    .btn-action.apply-bulk-btn:hover:not(:disabled) {
      background: var(--gold);
      color: var(--navy);
    }
    .btn-action:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      pointer-events: none;
    }

    /* Page Category Badges */
    .page-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.68rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: capitalize;
      letter-spacing: 0.02em;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #D1D5DB;
    }
    .page-badge.badge-home { color: #60A5FA; border-color: rgba(96, 165, 250, 0.4); background: rgba(30, 58, 138, 0.75); }
    .page-badge.badge-flying-training { color: #34D399; border-color: rgba(52, 211, 153, 0.4); background: rgba(6, 78, 59, 0.75); }
    .page-badge.badge-ground-training { color: #FBBF24; border-color: rgba(251, 191, 36, 0.4); background: rgba(120, 53, 15, 0.75); }
    .page-badge.badge-gallery-alumni { color: #A78BFA; border-color: rgba(167, 139, 250, 0.4); background: rgba(76, 29, 149, 0.75); }
    .page-badge.badge-gallery-student { color: #F472B6; border-color: rgba(244, 114, 182, 0.4); background: rgba(131, 24, 67, 0.75); }
    .page-badge.badge-gallery-media { color: #38BDF8; border-color: rgba(56, 189, 248, 0.4); background: rgba(12, 74, 110, 0.75); }
    .page-badge.badge-cabin-crew { color: #FB923C; border-color: rgba(251, 146, 60, 0.4); background: rgba(124, 45, 18, 0.75); }
    .page-badge.badge-uncategorized { color: #9CA3AF; border-color: rgba(156, 163, 175, 0.3); background: rgba(31, 41, 55, 0.75); }

    /* ═══════════════════════════════════════════════
       EMPTY & LOADING STATES
    ═══════════════════════════════════════════════ */
    .empty-state {
      text-align: center; padding: 60px 24px; display: none;
    }
    .empty-state.show { display: block; }
    .empty-icon { font-size: 3rem; color: var(--text-dimmed); margin-bottom: 16px; }
    .empty-title { font-family: 'Outfit', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; }
    .empty-sub { font-size: 0.85rem; color: var(--text-dimmed); }

    .loading-spinner {
      text-align: center; padding: 40px; color: var(--gold); font-size: 1.8rem;
    }

    /* ═══════════════════════════════════════════════
       LIGHTBOX PREVIEW
    ═══════════════════════════════════════════════ */
    .lightbox {
      position: fixed; inset: 0; z-index: 9000;
      background: rgba(0, 0, 0, 0.94); backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: none; align-items: center; justify-content: center;
      padding: 24px;
    }
    .lightbox.open { display: flex; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .lb-inner { position: relative; max-width: 90vw; max-height: 88vh; text-align: center; }
    .lb-img { max-width: 100%; max-height: 82vh; border-radius: 12px; object-fit: contain; box-shadow: 0 24px 80px rgba(0, 0, 0, 0.8); }
    .lb-close {
      position: fixed; top: 20px; right: 24px;
      width: 40px; height: 40px; border-radius: 10px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--white); cursor: pointer; font-size: 1.1rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .lb-close:hover { background: rgba(239, 68, 68, 0.3); color: #FCA5A5; }
    .lb-caption {
      margin-top: 14px; text-align: center;
      font-size: 0.88rem; color: rgba(255, 255, 255, 0.7);
    }
    .lb-nav {
      position: fixed; top: 50%; transform: translateY(-50%);
      width: 44px; height: 44px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--white); cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .lb-nav:hover { background: rgba(244, 179, 36, 0.25); border-color: rgba(244, 179, 36, 0.5); }
    .lb-prev { left: 16px; }
    .lb-next { right: 16px; }

    /* ═══════════════════════════════════════════════
       CONFIRM DELETE MODAL
    ═══════════════════════════════════════════════ */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 8000;
      background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none; align-items: center; justify-content: center;
      padding: 16px;
    }
    .modal-overlay.open { display: flex; animation: fadeIn 0.2s ease; }
    .modal-box {
      background: var(--navy-mid); border: 1px solid var(--navy-border);
      border-radius: 16px; padding: 32px 28px; width: 100%; max-width: 400px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
      animation: slideUp 0.25s ease;
    }
    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .modal-icon { font-size: 2.2rem; color: var(--error); margin-bottom: 14px; }
    .modal-title { font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; color: var(--white); }
    .modal-body { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 24px; line-height: 1.5; }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
    .btn-cancel {
      padding: 9px 20px; border-radius: 9px;
      background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border);
      color: var(--text-muted); font-size: 0.88rem; cursor: pointer; transition: all 0.2s;
    }
    .btn-cancel:hover { color: var(--white); background: rgba(255, 255, 255, 0.12); }
    .btn-confirm-del {
      padding: 9px 20px; border-radius: 9px;
      background: var(--error); border: none;
      color: var(--white); font-size: 0.88rem; font-weight: 600;
      cursor: pointer; transition: all 0.2s;
    }
    .btn-confirm-del:hover { background: #DC2626; }

    /* ═══════════════════════════════════════════════
       TOAST NOTIFICATIONS
    ═══════════════════════════════════════════════ */
    .toast {
      position: fixed; bottom: 24px; right: 24px;
      min-width: 280px; max-width: 380px;
      background: var(--navy-mid); border: 1px solid var(--border);
      border-radius: 12px; padding: 14px 18px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
      z-index: 9999; transform: translateY(120%); opacity: 0;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast-icon { font-size: 1.15rem; flex-shrink: 0; }
    .toast-icon.success { color: var(--success); }
    .toast-icon.error   { color: var(--error); }
    .toast-text { font-size: 0.88rem; color: var(--text-primary); font-weight: 500; }

    /* ═══════════════════════════════════════════════
       SIDEBAR OVERLAY (mobile)
    ═══════════════════════════════════════════════ */
    .sidebar-overlay {
      display: none; position: fixed; inset: 0; z-index: 99;
      background: rgba(0, 0, 0, 0.65);
    }
    .sidebar-overlay.show { display: block; }

    /* ═══════════════════════════════════════════════
       RESPONSIVE DESIGN
    ═══════════════════════════════════════════════ */
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .topbar { left: 0; }
      .hamburger-btn { display: block; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .content-area { padding: 20px 16px; }
    }
    @media (max-width: 480px) {
      .stats-row { grid-template-columns: 1fr; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .gallery-toolbar { flex-direction: column; align-items: stretch; }
      .search-wrap { max-width: 100%; }
    }
  </style>
</head>

<body>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar" role="navigation" aria-label="Admin sidebar">
    <div class="sidebar-brand">
      <img src="/images/logo3.webp" alt="Air Prime Asia" onerror="this.src='/assests/images/logo.png'">
      <div class="sidebar-brand-text">
        <strong>Air Prime Asia</strong>
        <span>Admin Panel</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-label">Management</div>
      <a class="nav-link active" id="nav-gallery" href="/admin/panel" role="menuitem" aria-current="page">
        <i class="fas fa-images"></i>
        Gallery
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/admin/logout" class="btn-logout" id="btn-logout" style="text-decoration:none;" aria-label="Logout">
        <i class="fas fa-sign-out-alt"></i>
        Logout
      </a>
    </div>
  </aside>

  <!-- Sidebar mobile overlay -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <!-- Top Bar -->
  <header class="topbar" role="banner">
    <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle sidebar" aria-expanded="false">
      <i class="fas fa-bars"></i>
    </button>
    <div class="topbar-title">Gallery <span>Management</span></div>
    <div class="topbar-user">
      <div class="topbar-badge">
        <i class="fas fa-circle"></i>
        <%= (typeof admin !== 'undefined' && admin && admin.username) ? admin.username : 'Admin' %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content" id="main-content" role="main">
    <div class="content-area">

      <!-- Stats Row -->
      <div class="stats-row" id="stats-row">
        <div class="stat-card">
          <div class="stat-icon gold"><i class="fas fa-images"></i></div>
          <div class="stat-info">
            <strong id="stat-total">0</strong>
            <span>Total Images</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon blue"><i class="fas fa-check-square"></i></div>
          <div class="stat-info">
            <strong id="stat-selected">0</strong>
            <span>Selected</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green"><i class="fas fa-cloud-upload-alt"></i></div>
          <div class="stat-info">
            <strong id="stat-uploaded">0</strong>
            <span>Uploaded Today</span>
          </div>
        </div>
      </div>

      <!-- Upload Section -->
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div class="section-title"><i class="fas fa-cloud-upload-alt"></i> Upload Images</div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <label for="upload-page-select" style="font-size: 0.85rem; color: var(--text-muted);">Upload Category:</label>
          <select class="upload-page-select" id="upload-page-select" aria-label="Select target page for uploaded images">
            <option value="uncategorized">Uncategorized</option>
            <option value="home">Home</option>
            <option value="flying-training">Flying Training</option>
            <option value="ground-training">Ground Training</option>
            <option value="gallery-alumni">Alumni Gallery</option>
            <option value="gallery-student">Student Gallery</option>
            <option value="gallery-media">Media Gallery</option>
            <option value="cabin-crew">Cabin Crew</option>
          </select>
        </div>
      </div>

      <div class="upload-zone" id="upload-zone" role="button" tabindex="0" aria-label="Upload images area">
        <input type="file" id="file-input" multiple accept="image/jpeg,image/png,image/gif,image/webp" aria-label="Select images to upload">
        <div class="upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
        <div class="upload-title">Drag &amp; drop images here</div>
        <div class="upload-sub">or click to browse from your device (Max 5MB per file)</div>
        <div class="upload-types">
          <span class="type-badge">JPG</span>
          <span class="type-badge">PNG</span>
          <span class="type-badge">WEBP</span>
          <span class="type-badge">GIF</span>
        </div>
      </div>

      <!-- Upload Progress -->
      <div class="upload-progress" id="upload-progress">
        <div class="progress-label">
          <span id="progress-text">Uploading to Cloudflare R2…</span>
          <span id="progress-pct">0%</span>
        </div>
        <div class="progress-bar-wrap">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
      </div>

      <!-- Gallery Section -->
      <div class="section-header">
        <div class="section-title"><i class="fas fa-th"></i> Gallery Images</div>
      </div>

      <!-- Toolbar -->
      <div class="gallery-toolbar">
        <div class="search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" class="search-input" id="search-input" placeholder="Search by name…" aria-label="Search images">
        </div>
        <select class="filter-page-select" id="filter-page-select" aria-label="Filter by page">
          <option value="all">All Categories</option>
          <option value="home">Home</option>
          <option value="flying-training">Flying Training</option>
          <option value="ground-training">Ground Training</option>
          <option value="gallery-alumni">Alumni Gallery</option>
          <option value="gallery-student">Student Gallery</option>
          <option value="gallery-media">Media Gallery</option>
          <option value="cabin-crew">Cabin Crew</option>
          <option value="uncategorized">Uncategorized</option>
        </select>
        <div class="view-toggle">
          <button class="view-btn active" id="grid-btn" title="Grid view" aria-label="Grid view">
            <i class="fas fa-th"></i>
          </button>
          <button class="view-btn" id="list-btn" title="List view" aria-label="List view">
            <i class="fas fa-list"></i>
          </button>
        </div>
        <button class="btn-action select-all-btn" id="select-all-btn">
          <i class="fas fa-check-square"></i> Select All
        </button>
        <div class="bulk-group">
          <select id="bulk-page-select" class="bulk-page-select" aria-label="Select target page category for bulk update">
            <option value="" disabled selected>Assign to Page...</option>
            <option value="home">Home</option>
            <option value="flying-training">Flying Training</option>
            <option value="ground-training">Ground Training</option>
            <option value="gallery-alumni">Alumni Gallery</option>
            <option value="gallery-student">Student Gallery</option>
            <option value="gallery-media">Media Gallery</option>
            <option value="cabin-crew">Cabin Crew</option>
            <option value="uncategorized">Uncategorized</option>
          </select>
          <button class="btn-action apply-bulk-btn" id="apply-bulk-btn" disabled>
            <i class="fas fa-tags"></i> Apply (<span id="bulk-sel-count">0</span>)
          </button>
        </div>
        <button class="btn-action delete-selected-btn" id="delete-selected-btn">
          <i class="fas fa-trash-alt"></i> Delete (<span id="sel-count">0</span>)
        </button>
        <button class="btn-action quick-tag-btn" id="quick-tag-btn" title="Rapidly tag uncategorized images one by one">
          ⚡ Quick Tag Mode
        </button>
        <button class="btn-action refresh-btn" id="refresh-btn" title="Refresh gallery">
          <i class="fas fa-sync-alt" id="refresh-icon"></i>
        </button>
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-grid" id="gallery-grid" aria-label="Image gallery">
        <div class="loading-spinner" id="loading-spinner">
          <i class="fas fa-circle-notch fa-spin"></i>
        </div>
      </div>

      <!-- Empty State -->
      <div class="empty-state" id="empty-state">
        <div class="empty-icon"><i class="fas fa-images"></i></div>
        <div class="empty-title">No images in gallery</div>
        <div class="empty-sub">Upload images above to store them in Cloudflare R2 and MongoDB.</div>
      </div>

    </div>
  </main>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview">
    <button class="lb-close" id="lb-close" aria-label="Close preview"><i class="fas fa-times"></i></button>
    <button class="lb-nav lb-prev" id="lb-prev" aria-label="Previous image"><i class="fas fa-chevron-left"></i></button>
    <div class="lb-inner">
      <img class="lb-img" id="lb-img" src="" alt="Preview">
      <div class="lb-caption" id="lb-caption"></div>
    </div>
    <button class="lb-nav lb-next" id="lb-next" aria-label="Next image"><i class="fas fa-chevron-right"></i></button>
  </div>

  <!-- Confirm Delete Modal -->
  <div class="modal-overlay" id="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
      <div class="modal-icon"><i class="fas fa-trash-alt"></i></div>
      <div class="modal-title" id="modal-title">Delete Image(s)?</div>
      <div class="modal-body" id="modal-body">Are you sure you want to delete the selected image(s)? This will remove them from Cloudflare R2 storage and database permanently.</div>
      <div class="modal-actions">
        <button class="btn-cancel" id="modal-cancel">Cancel</button>
        <button class="btn-confirm-del" id="modal-confirm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast" id="toast" role="status" aria-live="polite">
    <i class="toast-icon" id="toast-icon"></i>
    <span class="toast-text" id="toast-text"></span>
  </div>

  <!-- ⚡ Quick Tag Mode Modal -->
  <div class="qtm-overlay" id="qtm-overlay" role="dialog" aria-modal="true" aria-label="Quick Tag Mode">
    <!-- Header -->
    <div class="qtm-header">
      <div class="qtm-progress" id="qtm-progress">Loading…</div>
      <div class="qtm-title">⚡ Quick Tag Mode</div>
      <button class="qtm-close" id="qtm-close" aria-label="Close Quick Tag Mode">✕ Close</button>
    </div>

    <!-- Image Stage -->
    <div class="qtm-stage" id="qtm-stage">
      <!-- Loading state -->
      <div class="qtm-loading" id="qtm-loading">
        <i class="fas fa-circle-notch fa-spin"></i>
        <p>Loading uncategorized images…</p>
      </div>

      <!-- Done state -->
      <div class="qtm-done" id="qtm-done" style="display:none;">
        <div class="qtm-done-icon">🎉</div>
        <div class="qtm-done-title">Saari images tag ho gayi!</div>
        <div class="qtm-done-sub">All uncategorized images have been assigned a category.</div>
        <button class="qtm-done-close" id="qtm-done-close">Close</button>
      </div>

      <!-- Active image viewer -->
      <div class="qtm-viewer" id="qtm-viewer" style="display:none;">
        <div class="qtm-img-wrap">
          <img class="qtm-img" id="qtm-img" src="" alt="">
        </div>
        <div class="qtm-filename" id="qtm-filename"></div>
        <div class="qtm-kbd-hint">Keyboard: <kbd>1</kbd>–<kbd>7</kbd> = categories &nbsp;|&nbsp; <kbd>S</kbd> = Skip</div>
      </div>
    </div>

    <!-- Category Buttons -->
    <div class="qtm-actions" id="qtm-actions" style="display:none;">
      <button class="qtm-cat-btn" data-page="home"            data-key="1"><span class="qtm-key">1</span>Home</button>
      <button class="qtm-cat-btn" data-page="flying-training" data-key="2"><span class="qtm-key">2</span>Flying Training</button>
      <button class="qtm-cat-btn" data-page="ground-training" data-key="3"><span class="qtm-key">3</span>Ground Training</button>
      <button class="qtm-cat-btn" data-page="gallery-alumni" data-key="4"><span class="qtm-key">4</span>Alumni Gallery</button>
      <button class="qtm-cat-btn" data-page="gallery-student" data-key="5"><span class="qtm-key">5</span>Student Gallery</button>
      <button class="qtm-cat-btn" data-page="gallery-media"  data-key="6"><span class="qtm-key">6</span>Media Gallery</button>
      <button class="qtm-cat-btn" data-page="cabin-crew"     data-key="7"><span class="qtm-key">7</span>Cabin Crew</button>
      <button class="qtm-cat-btn qtm-skip-btn" data-page="skip" data-key="S"><span class="qtm-key">S</span>Skip</button>
    </div>
  </div>

  <script>
    'use strict';

    // ─── State ────────────────────────────────────────────────────────
    var images = [];          // Loaded from /api/gallery/images
    var selectedIds = new Set();
    var currentLbIndex = -1;
    var searchQuery = '';
    var isListView = false;
    var uploadedToday = 0;
    var deleteCallback = null;
    var selectedFilterPage = 'all';

    function getPageLabel(pageKey) {
      var map = {
        'home': 'Home',
        'flying-training': 'Flying Training',
        'ground-training': 'Ground Training',
        'gallery-alumni': 'Alumni Gallery',
        'gallery-student': 'Student Gallery',
        'gallery-media': 'Media Gallery',
        'cabin-crew': 'Cabin Crew',
        'uncategorized': 'Uncategorized'
      };
      return map[pageKey] || pageKey || 'Uncategorized';
    }

    // ─── Fetch Images from API ────────────────────────────────────────
    async function fetchImages(silent) {
      if (!silent) {
        var spin = document.getElementById('loading-spinner');
        if (spin) spin.style.display = 'block';
      }

      try {
        var url = '/api/gallery/images' + (selectedFilterPage !== 'all' ? '?page=' + encodeURIComponent(selectedFilterPage) : '');
        var res = await fetch(url);
        var data = await res.json();

        if (res.ok && data.success) {
          images = data.images || [];
          // Retain only selected IDs that still exist in current view
          var currentIds = new Set(images.map(function(img) { return img.id; }));
          selectedIds.forEach(function(id) {
            if (!currentIds.has(id)) selectedIds.delete(id);
          });
          calculateUploadedToday();
          render();
        } else {
          showToast('error', data.message || 'Failed to load gallery images.');
        }
      } catch (err) {
        console.error('Error fetching images:', err);
        showToast('error', 'Network error fetching images.');
      } finally {
        var spin = document.getElementById('loading-spinner');
        if (spin) spin.style.display = 'none';
      }
    }

    function calculateUploadedToday() {
      var todayStr = new Date().toDateString();
      uploadedToday = images.filter(function (img) {
        if (!img.createdAt) return false;
        return new Date(img.createdAt).toDateString() === todayStr;
      }).length;
    }

    // ─── Render ────────────────────────────────────────────────────────
    function getFilteredImages() {
      if (!searchQuery) return images;
      var q = searchQuery.toLowerCase();
      return images.filter(function (img) {
        var name = (img.originalName || img.title || '').toLowerCase();
        var page = (img.page || '').toLowerCase();
        return name.includes(q) || page.includes(q);
      });
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        var d = new Date(dateStr);
        return d.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
      } catch(e) {
        return dateStr;
      }
    }

    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      var k = 1024;
      var sizes = ['B', 'KB', 'MB', 'GB'];
      var i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function render() {
      var filtered = getFilteredImages();
      var grid = document.getElementById('gallery-grid');
      var empty = document.getElementById('empty-state');

      // Update statistics
      document.getElementById('stat-total').textContent = images.length;
      document.getElementById('stat-selected').textContent = selectedIds.size;
      document.getElementById('stat-uploaded').textContent = uploadedToday;

      // Update delete selected button state
      var delBtn = document.getElementById('delete-selected-btn');
      document.getElementById('sel-count').textContent = selectedIds.size;
      if (selectedIds.size > 0) {
        delBtn.classList.add('visible');
      } else {
        delBtn.classList.remove('visible');
      }

      // Update bulk assign button state
      var bulkBtn = document.getElementById('apply-bulk-btn');
      var bulkCountSpan = document.getElementById('bulk-sel-count');
      if (bulkCountSpan) bulkCountSpan.textContent = selectedIds.size;
      if (bulkBtn) bulkBtn.disabled = selectedIds.size === 0;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        empty.classList.add('show');
        return;
      }
      empty.classList.remove('show');

      grid.innerHTML = '';
      filtered.forEach(function (img) {
        var isSelected = selectedIds.has(img.id);
        var el = document.createElement('div');
        el.className = 'gallery-item' + (isSelected ? ' selected' : '');
        el.dataset.id = img.id;
        var displayName = img.originalName || img.title || 'Untitled Image';
        var dateFormatted = formatDate(img.createdAt);
        var sizeFormatted = formatBytes(img.fileSize);
        var pageKey = img.page || 'uncategorized';
        var pageLabel = getPageLabel(pageKey);

        if (isListView) {
          el.innerHTML =
            '<div class="img-thumb-wrap">' +
              '<img class="gallery-img" src="' + img.filePath + '" alt="' + esc(displayName) + '" loading="lazy" onerror="this.src=\'/images/hero-home.jpg\'">' +
            '</div>' +
            '<div class="item-info">' +
              '<span class="item-name">' + esc(displayName) + '</span>' +
              '<div class="item-meta">' +
                '<span><i class="far fa-calendar-alt"></i> ' + dateFormatted + '</span>' +
                '<span><i class="fas fa-database"></i> ' + sizeFormatted + '</span>' +
                '<span class="page-badge badge-' + esc(pageKey) + '">' + esc(pageLabel) + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="list-actions">' +
              '<a class="list-action-btn" href="' + img.filePath + '" target="_blank" rel="noopener noreferrer" title="Open in new tab"><i class="fas fa-external-link-alt"></i></a>' +
              '<button class="list-action-btn preview-btn" data-id="' + img.id + '" title="Preview"><i class="fas fa-eye"></i></button>' +
              '<button class="list-action-btn del delete-btn" data-id="' + img.id + '" title="Delete"><i class="fas fa-trash"></i></button>' +
            '</div>';
        } else {
          el.innerHTML =
            '<div class="img-thumb-wrap">' +
              '<img class="gallery-img" src="' + img.filePath + '" alt="' + esc(displayName) + '" loading="lazy" onerror="this.src=\'/images/hero-home.jpg\'">' +
              '<div class="item-overlay">' +
                '<div class="overlay-top">' +
                  '<div class="cb-select' + (isSelected ? ' checked' : '') + '" data-id="' + img.id + '" role="checkbox" aria-checked="' + isSelected + '" tabindex="0"><i class="fas fa-check"></i></div>' +
                  '<span class="page-badge badge-' + esc(pageKey) + '">' + esc(pageLabel) + '</span>' +
                '</div>' +
                '<div class="overlay-bottom">' +
                  '<span class="item-filename" title="' + esc(displayName) + '">' + esc(displayName) + '</span>' +
                  '<div class="overlay-actions">' +
                    '<a class="action-btn" href="' + img.filePath + '" target="_blank" rel="noopener noreferrer" title="Open in new tab"><i class="fas fa-external-link-alt"></i></a>' +
                    '<button class="action-btn preview-btn" data-id="' + img.id + '" title="Preview"><i class="fas fa-eye"></i></button>' +
                    '<button class="action-btn del delete-btn" data-id="' + img.id + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>';
        }

        grid.appendChild(el);
      });

      // Bind events
      grid.querySelectorAll('.cb-select').forEach(function (cb) {
        cb.addEventListener('click', function (e) { e.stopPropagation(); toggleSelect(cb.dataset.id); });
        cb.addEventListener('keydown', function (e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggleSelect(cb.dataset.id); } });
      });
      grid.querySelectorAll('.preview-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) { e.stopPropagation(); openLightbox(btn.dataset.id); });
      });
      grid.querySelectorAll('.delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) { e.stopPropagation(); confirmDelete([btn.dataset.id], 'Delete Image?', 'Are you sure you want to permanently delete this image from Cloudflare R2 and the database?'); });
      });
      grid.querySelectorAll('.gallery-item').forEach(function (item) {
        item.addEventListener('click', function () {
          if (isListView) { openLightbox(item.dataset.id); }
          else { toggleSelect(item.dataset.id); }
        });
      });
    }

    function esc(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ─── Select & Select All ──────────────────────────────────────────
    function toggleSelect(id) {
      if (selectedIds.has(id)) { selectedIds.delete(id); } else { selectedIds.add(id); }
      render();
    }

    document.getElementById('select-all-btn').addEventListener('click', function () {
      var filtered = getFilteredImages();
      if (selectedIds.size === filtered.length && filtered.length > 0) {
        selectedIds.clear();
      } else {
        filtered.forEach(function (img) { selectedIds.add(img.id); });
      }
      render();
    });

    // ─── Bulk Update Category ─────────────────────────────────────────
    document.getElementById('apply-bulk-btn').addEventListener('click', async function () {
      if (selectedIds.size === 0) return;
      var targetPage = document.getElementById('bulk-page-select').value;
      if (!targetPage) {
        showToast('error', 'Please select a page category from the dropdown.');
        return;
      }

      var ids = Array.from(selectedIds);
      var pageLabel = getPageLabel(targetPage);
      var btn = this;
      btn.disabled = true;

      try {
        var res = await fetch('/api/gallery/bulk-update', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: ids, page: targetPage }),
        });

        var data = await res.json();
        if (res.ok && data.success) {
          showToast('success', (data.modifiedCount || ids.length) + ' image(s) tagged as "' + pageLabel + '"');
          // Update local objects
          images.forEach(function (img) {
            if (selectedIds.has(img.id)) {
              img.page = targetPage;
            }
          });
          selectedIds.clear();
          render();
        } else {
          showToast('error', data.message || 'Failed to update image categories.');
        }
      } catch (err) {
        console.error('Bulk update error:', err);
        showToast('error', 'Network error updating image categories.');
      } finally {
        btn.disabled = selectedIds.size === 0;
      }
    });

    // ─── Filter By Page ───────────────────────────────────────────────
    document.getElementById('filter-page-select').addEventListener('change', function () {
      selectedFilterPage = this.value;
      fetchImages(false);
    });

    // ─── Delete Operations ────────────────────────────────────────────
    function confirmDelete(ids, title, body) {
      document.getElementById('modal-title').textContent = title;
      document.getElementById('modal-body').textContent = body;
      document.getElementById('modal-overlay').classList.add('open');
      deleteCallback = function () { doDelete(ids); };
    }

    document.getElementById('modal-cancel').addEventListener('click', closeModal);
    document.getElementById('modal-overlay').addEventListener('click', function (e) { if (e.target === this) closeModal(); });
    document.getElementById('modal-confirm').addEventListener('click', function () {
      closeModal();
      if (deleteCallback) { deleteCallback(); deleteCallback = null; }
    });

    function closeModal() { document.getElementById('modal-overlay').classList.remove('open'); }

    async function doDelete(ids) {
      if (!ids || ids.length === 0) return;

      try {
        var res;
        if (ids.length === 1) {
          res = await fetch('/api/gallery/images/' + ids[0], { method: 'DELETE' });
        } else {
          res = await fetch('/api/gallery/images', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: ids }),
          });
        }

        var data = await res.json();
        if (res.ok && data.success) {
          images = images.filter(function (img) { return !ids.includes(img.id); });
          ids.forEach(function (id) { selectedIds.delete(id); });
          calculateUploadedToday();
          render();
          showToast('success', data.message || 'Image(s) deleted successfully.');
        } else {
          showToast('error', data.message || 'Failed to delete image(s).');
        }
      } catch (err) {
        console.error('Delete error:', err);
        showToast('error', 'Error deleting image(s). Please try again.');
      }
    }

    document.getElementById('delete-selected-btn').addEventListener('click', function () {
      if (selectedIds.size === 0) return;
      var ids = Array.from(selectedIds);
      confirmDelete(ids, 'Delete ' + ids.length + ' image(s)?', 'Are you sure you want to permanently delete the ' + ids.length + ' selected image(s) from Cloudflare R2 and the database?');
    });

    // ─── Upload Handling ──────────────────────────────────────────────
    var fileInput = document.getElementById('file-input');
    var uploadZone = document.getElementById('upload-zone');

    uploadZone.addEventListener('dragover', function (e) { e.preventDefault(); uploadZone.classList.add('drag-over'); });
    uploadZone.addEventListener('dragleave', function () { uploadZone.classList.remove('drag-over'); });
    uploadZone.addEventListener('drop', function (e) {
      e.preventDefault(); uploadZone.classList.remove('drag-over');
      uploadFiles(e.dataTransfer.files);
    });
    uploadZone.addEventListener('keydown', function (e) {
      if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); fileInput.click(); }
    });

    fileInput.addEventListener('change', function () { uploadFiles(this.files); });

    async function uploadFiles(files) {
      if (!files || files.length === 0) return;
      var validFiles = Array.from(files).filter(function (f) { return f.type.startsWith('image/'); });
      if (validFiles.length === 0) {
        showToast('error', 'Please select valid image files (JPG, PNG, GIF, WEBP).');
        return;
      }

      var uploadCategory = document.getElementById('upload-page-select')?.value || 'uncategorized';
      var progress = document.getElementById('upload-progress');
      var bar = document.getElementById('progress-bar');
      var pct = document.getElementById('progress-pct');
      var txt = document.getElementById('progress-text');
      progress.classList.add('show');
      bar.style.width = '30%';
      pct.textContent = '30%';
      txt.textContent = 'Uploading ' + validFiles.length + ' file(s) to ' + getPageLabel(uploadCategory) + '...';

      var formData = new FormData();
      formData.append('page', uploadCategory);
      validFiles.forEach(function (file) {
        formData.append('images', file);
      });

      try {
        bar.style.width = '65%';
        pct.textContent = '65%';

        var res = await fetch('/api/gallery/upload', {
          method: 'POST',
          body: formData,
        });

        var data = await res.json();
        bar.style.width = '100%';
        pct.textContent = '100%';

        if (res.ok && data.success) {
          showToast('success', data.message || 'Upload completed successfully.');
          await fetchImages(true);
        } else {
          showToast('error', data.message || 'Upload failed.');
        }
      } catch (err) {
        console.error('Upload error:', err);
        showToast('error', 'Upload error occurred.');
      } finally {
        setTimeout(function () {
          progress.classList.remove('show');
          bar.style.width = '0%';
        }, 800);
        fileInput.value = '';
      }
    }

    // ─── Search Input ─────────────────────────────────────────────────
    document.getElementById('search-input').addEventListener('input', function () {
      searchQuery = this.value.trim();
      render();
    });

    // ─── View Toggle ──────────────────────────────────────────────────
    document.getElementById('grid-btn').addEventListener('click', function () {
      isListView = false;
      document.getElementById('gallery-grid').classList.remove('list-view');
      this.classList.add('active');
      document.getElementById('list-btn').classList.remove('active');
      render();
    });
    document.getElementById('list-btn').addEventListener('click', function () {
      isListView = true;
      document.getElementById('gallery-grid').classList.add('list-view');
      this.classList.add('active');
      document.getElementById('grid-btn').classList.remove('active');
      render();
    });

    // ─── Manual Refresh ───────────────────────────────────────────────
    document.getElementById('refresh-btn').addEventListener('click', function () {
      var icon = document.getElementById('refresh-icon');
      icon.classList.add('fa-spin');
      fetchImages(true).then(function () {
        setTimeout(function () { icon.classList.remove('fa-spin'); }, 500);
        showToast('success', 'Gallery refreshed.');
      });
    });

    // ─── Lightbox ─────────────────────────────────────────────────────
    function openLightbox(id) {
      var filtered = getFilteredImages();
      currentLbIndex = filtered.findIndex(function (img) { return img.id === id; });
      showLightboxItem(currentLbIndex);
    }

    function showLightboxItem(idx) {
      var filtered = getFilteredImages();
      if (idx < 0 || idx >= filtered.length) return;
      currentLbIndex = idx;
      var item = filtered[idx];
      var name = item.originalName || item.title || 'Preview';
      document.getElementById('lb-img').src = item.filePath;
      document.getElementById('lb-img').alt = name;
      document.getElementById('lb-caption').textContent = name + ' (' + (idx + 1) + ' of ' + filtered.length + ')';
      document.getElementById('lightbox').classList.add('open');
    }

    document.getElementById('lb-close').addEventListener('click', closeLightbox);
    document.getElementById('lightbox').addEventListener('click', function (e) { if (e.target === this) closeLightbox(); });
    document.getElementById('lb-prev').addEventListener('click', function () { showLightboxItem(currentLbIndex - 1); });
    document.getElementById('lb-next').addEventListener('click', function () { showLightboxItem(currentLbIndex + 1); });

    document.addEventListener('keydown', function (e) {
      var lb = document.getElementById('lightbox');
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') { closeLightbox(); }
      if (e.key === 'ArrowLeft') { showLightboxItem(currentLbIndex - 1); }
      if (e.key === 'ArrowRight') { showLightboxItem(currentLbIndex + 1); }
    });

    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('open');
      document.getElementById('lb-img').src = '';
    }

    // ─── Toast System ─────────────────────────────────────────────────
    var toastTimer = null;
    function showToast(type, msg) {
      var t = document.getElementById('toast');
      var icon = document.getElementById('toast-icon');
      var text = document.getElementById('toast-text');
      icon.className = 'toast-icon ' + type;
      icon.innerHTML = type === 'success' ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-times-circle"></i>';
      text.textContent = msg;
      t.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { t.classList.remove('show'); }, 3500);
    }

    // ─── Mobile Sidebar Toggle ────────────────────────────────────────
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('sidebar-overlay');
    var hbBtn   = document.getElementById('hamburger-btn');

    hbBtn.addEventListener('click', function () {
      var open = sidebar.classList.toggle('open');
      overlay.classList.toggle('show', open);
      hbBtn.setAttribute('aria-expanded', open);
    });
    overlay.addEventListener('click', function () {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      hbBtn.setAttribute('aria-expanded', 'false');
    });

    // ─── Initialization & Auto-Refresh every 60 seconds ───────────────
    fetchImages();
    setInterval(function () {
      fetchImages(true);
    }, 60000);

    // ═══════════════════════════════════════════════════════════════════
    // ⚡ QUICK TAG MODE
    // ═══════════════════════════════════════════════════════════════════
    var qtmQueue       = [];   // full list of uncategorized images
    var qtmIndex       = 0;   // current position in queue
    var qtmBusy        = false; // prevent double-clicks during API call
    var qtmSkipSet     = new Set(); // IDs that were skipped this session

    // — DOM refs —
    var qtmOverlay  = document.getElementById('qtm-overlay');
    var qtmLoading  = document.getElementById('qtm-loading');
    var qtmDone     = document.getElementById('qtm-done');
    var qtmViewer   = document.getElementById('qtm-viewer');
    var qtmActions  = document.getElementById('qtm-actions');
    var qtmImg      = document.getElementById('qtm-img');
    var qtmFilename = document.getElementById('qtm-filename');
    var qtmProgress = document.getElementById('qtm-progress');

    // Open Quick Tag Mode
    document.getElementById('quick-tag-btn').addEventListener('click', function () {
      openQuickTagMode();
    });

    async function openQuickTagMode() {
      // Show overlay
      qtmOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';

      // Reset state
      qtmQueue = [];
      qtmIndex = 0;
      qtmSkipSet.clear();
      qtmBusy = false;

      // Show loading
      qtmLoading.style.display = '';
      qtmDone.style.display = 'none';
      qtmViewer.style.display = 'none';
      qtmActions.style.display = 'none';
      qtmProgress.textContent = 'Loading\u2026';

      // Fetch all uncategorized images
      try {
        var res = await fetch('/api/gallery/images?page=uncategorized');
        var data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'Fetch failed');

        qtmQueue = data.images || [];
        if (qtmQueue.length === 0) {
          showQtmDone();
          return;
        }
        showQtmImage(0);
      } catch (err) {
        console.error('Quick Tag Mode fetch error:', err);
        qtmLoading.style.display = 'none';
        qtmProgress.textContent = 'Error loading';
        showToast('error', 'Failed to load uncategorized images.');
      }
    }

    function closeQuickTagMode() {
      qtmOverlay.classList.remove('open');
      document.body.style.overflow = '';
      // Refresh main gallery in background to reflect any tag changes
      fetchImages(true);
    }

    function updateProgress() {
      // Show how many remain (unprocessed = total - current index, but skipped stay in queue)
      var remaining = qtmQueue.length - qtmIndex;
      qtmProgress.textContent = (qtmIndex + 1) + ' / ' + qtmQueue.length + ' remaining';
    }

    function showQtmImage(idx) {
      if (idx >= qtmQueue.length) {
        showQtmDone();
        return;
      }
      qtmIndex = idx;

      // Hide loading, show viewer + actions
      qtmLoading.style.display = 'none';
      qtmDone.style.display = 'none';
      qtmViewer.style.display = 'flex';
      qtmActions.style.display = 'flex';

      var imgData = qtmQueue[idx];
      updateProgress();

      // Fade-out then swap src then fade-in
      qtmImg.classList.add('fading');
      setTimeout(function () {
        qtmImg.src = imgData.filePath || '';
        qtmImg.alt = imgData.originalName || imgData.title || '';
        qtmFilename.textContent = imgData.originalName || imgData.title || 'Untitled';
        qtmImg.classList.remove('fading');
      }, 180);
    }

    function showQtmDone() {
      qtmLoading.style.display = 'none';
      qtmViewer.style.display = 'none';
      qtmActions.style.display = 'none';
      qtmDone.style.display = '';
      qtmProgress.textContent = 'All Done!';
    }

    // Tag current image and advance
    async function qtmTagCurrent(page) {
      if (qtmBusy || qtmIndex >= qtmQueue.length) return;

      var imgData = qtmQueue[qtmIndex];

      if (page === 'skip') {
        // Skip: mark as skipped and move to next
        qtmSkipSet.add(imgData.id);
        showQtmImage(qtmIndex + 1);
        return;
      }

      qtmBusy = true;

      try {
        var res = await fetch('/api/gallery/bulk-update', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: [imgData.id], page: page }),
        });
        var data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'Update failed');

        // Remove from queue (processed) and show next
        qtmQueue.splice(qtmIndex, 1);
        // Don't increment index — next item slides into current position
        var nextIdx = qtmIndex < qtmQueue.length ? qtmIndex : qtmQueue.length - 1;
        if (qtmQueue.length === 0) {
          showQtmDone();
        } else {
          showQtmImage(nextIdx);
        }
      } catch (err) {
        console.error('Quick Tag update error:', err);
        showToast('error', 'Failed to tag image. Try again.');
      } finally {
        qtmBusy = false;
      }
    }

    // Bind category buttons
    document.querySelectorAll('.qtm-cat-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        qtmTagCurrent(btn.getAttribute('data-page'));
      });
    });

    // Close buttons
    document.getElementById('qtm-close').addEventListener('click', closeQuickTagMode);
    document.getElementById('qtm-done-close').addEventListener('click', closeQuickTagMode);

    // Keyboard shortcuts — only when Quick Tag Mode is open
    document.addEventListener('keydown', function (e) {
      if (!qtmOverlay.classList.contains('open')) return;

      // Don't hijack if user is typing in an input somewhere
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

      var keyMap = { '1': 'home', '2': 'flying-training', '3': 'ground-training',
                     '4': 'gallery-alumni', '5': 'gallery-student',
                     '6': 'gallery-media', '7': 'cabin-crew' };

      if (keyMap[e.key]) {
        e.preventDefault();
        qtmTagCurrent(keyMap[e.key]);
      } else if (e.key === 's' || e.key === 'S') {
        e.preventDefault();
        qtmTagCurrent('skip');
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeQuickTagMode();
      }
    });
  </script>

</body>
</html>
